# Server Settings
APP_NAME="Airtable PO Generator"
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# Coolify Public URL (중요: Airtable이 PDF를 다운로드할 수 있는 공용 URL)
BASE_URL="https://po-service.yourdomain.com"

# Webhook 인증 시크릿 (선택 사항: 지정 시 Airtable 헤더 x-webhook-secret 검증)
WEBHOOK_SECRET="your-strong-random-secret-token"

# Airtable API 인증 정보
AIRTABLE_API_KEY="patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
AIRTABLE_BASE_ID="appXXXXXXXXXXXXXX"

# Airtable 테이블 이름 설정
PO_TABLE_NAME="Purchase Orders"
ITEMS_TABLE_NAME="Episodes"

# 부모 테이블 필드명 설정
FIELD_CHECKBOX="Generate PO"
FIELD_ATTACHMENT="PO Created"
FIELD_STATUS="Status"
FIELD_ITEMS_LINK="Episodes"
FIELD_LINGUIST_NAME="Linguist"
FIELD_LINGUIST_POSITION="Position"
FIELD_LINGUIST_EMAIL="Email"
FIELD_DATE_ISSUED="Date Issued"
FIELD_DEADLINE_MONTH="Deadline Month"
FIELD_PAYMENT_STATUS="Payment Status"

# 자식 테이블 필드명 설정
ITEM_FIELD_PROJECT="Project Description"
ITEM_FIELD_EPISODE="Episode"
ITEM_FIELD_DEADLINE="Deadline"
ITEM_FIELD_ROLE="Role"
ITEM_FIELD_RATE="Final Rate"
ITEM_FIELD_RUNTIME="Runtime"
ITEM_FIELD_AMOUNT="Amount"
